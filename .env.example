# Django
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# YOLO
# The Ultralytics package downloads this small pretrained model on first use.
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.25
YOLO_IMAGE_SIZE=832

# Temporal state (milliseconds and number of structured observations)
TRACK_MAX_AGE_MS=2000
TRACK_HISTORY_SIZE=12
TRACK_IOU_THRESHOLD=0.30
TRACK_DUPLICATE_IOU_THRESHOLD=0.75
MAX_ACTIVE_TRACKS=64

# Deterministic safety and response policy
PATH_LEFT_RATIO=0.26
PATH_RIGHT_RATIO=0.74
PATH_MIN_OVERLAP_RATIO=0.30
SAFETY_MIN_CONFIDENCE=0.55
SAFETY_BLOCK_CONFIRM_FRAMES=3
SAFETY_CLEAR_CONFIRM_FRAMES=3
ALERT_COOLDOWN_MS=5000
RESPONSE_QUEUE_LIMIT=3
RESPONSE_MAX_AGE_MS=15000
EMERGENCY_LABELS=fire,smoke

# On-demand local interaction services
OCR_MIN_CONFIDENCE=55
OCR_MAX_ATTEMPTS=2
VOSK_MODEL_PATH=models/vosk-model

# Optional rich local reasoning (never used by the camera/safety path)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=4
RICH_RESPONSE_MAX_CHARS=280
